@startuml deployment_umgebungen
title Deploymentdiagramm: Entwicklungs- und Zielumgebung

skinparam backgroundColor white
skinparam shadowing false
skinparam roundCorner 0
skinparam defaultFontSize 12
skinparam node {
  BackgroundColor #F5F5F5
  BorderColor #4D4D4D
}
skinparam database {
  BackgroundColor #F5F5F5
  BorderColor #4D4D4D
}
skinparam artifact {
  BackgroundColor #E3F2F1
  BorderColor #00707A
}
skinparam actor {
  BackgroundColor #F5F5F5
  BorderColor #4D4D4D
}
skinparam note {
  BackgroundColor #FAFAFA
  BorderColor #999999
}
skinparam ArrowColor #4D4D4D

package "Testumgebung (aktueller Ist-Zustand)" #F8F8F8 {
  node "Windows Server 2022\n(AD-Domänencontroller + Hyper-V-Host)" as DevVM {
    artifact "VmPortal.Api + Core\n(Backend, Local-Modus)" as DevBackend
    node "Hyper-V-Host\n(Test-VMs)" as DevHyperV
    database "Active Directory\n(Testdomäne)" as DevAD
  }
  DevBackend --> DevHyperV : lokale PowerShell
  DevBackend --> DevAD : LDAP (Port 389)
}

package "Zielumgebung — Siemens-Produktion" #F8F8F8 {
  node "Siemens-Firmennetz" as SiemensNet {
    node "Reverse Proxy\n(HTTPS-Terminierung)" as ReverseProxy
    node "Anwendungsserver\n(Backend, Remote-Modus)" as ProdBackend
    node "MHM-HYPERV1" as ProdHyperV1
    node "MHM-HYPERV3" as ProdHyperV3
    node "MHM-HYPERV4" as ProdHyperV4
    database "Domain Controller\n(archiv.mhm.siemens.com)" as ProdAD
  }

  actor "Mitarbeitende" as User

  User --> ReverseProxy : HTTPS
  ReverseProxy --> ProdBackend : HTTP (intern)
  ProdBackend -[#00707A]-> ProdHyperV1 : WinRM/Kerberos
  ProdBackend -[#00707A]-> ProdHyperV3 : WinRM/Kerberos
  ProdBackend -[#00707A]-> ProdHyperV4 : WinRM/Kerberos
  ProdBackend --> ProdAD : LDAPS (Port 636)
}

note bottom of ProdHyperV4
  Getrennter Anwendungs- und Hyper-V-Host: HyperVProvider
  steuert im Remote-Modus mehrere Hosts gleichzeitig über
  WinRM/Kerberos (Port 5985) an, implementiert und gegen
  alle drei Hosts erfolgreich getestet. Der Local-Modus
  bleibt als Alternative für Deployments mit gemeinsamem
  Anwendungs-/Hyper-V-Host bestehen.
end note

DevVM -[hidden]-> SiemensNet

@enduml

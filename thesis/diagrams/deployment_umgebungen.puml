@startuml deployment_umgebungen
title Deploymentdiagramm: Entwicklungs- und Zielumgebung

skinparam backgroundColor white
skinparam node {
  BackgroundColor #F2F2F2
  BorderColor #444444
}
skinparam database {
  BackgroundColor #E3F2FD
  BorderColor #1565C0
}
skinparam artifact {
  BackgroundColor #FFF3CD
  BorderColor #B8860B
}

package "Testumgebung (aktueller Ist-Zustand)" #F8F8F8 {
  node "Windows Server 2022\n(AD-Domänencontroller + Hyper-V-Host)" as DevVM {
    artifact "VmPortal.Api + Core\n(Backend, lokal ausgeführt)" as DevBackend
    node "Hyper-V-Host\n(Test-VMs: VM-Mikail, VM-Burath)" as DevHyperV
    database "Active Directory\n(Testdomäne\ntestumgebung.local)" as DevAD
  }
  DevBackend -[#444444]-> DevHyperV : lokale PowerShell\n(kein WinRM)
  DevBackend -[#444444]-> DevAD : LDAP (Port 389)
}

package "Zielumgebung — Siemens-Produktion" #F8F8F8 {
  node "Siemens-Firmennetz" as SiemensNet {
    node "Reverse Proxy\n(HTTPS-Terminierung)" as ReverseProxy
    node "Anwendungsserver\n(Backend: VmPortal.Api + Core)" as ProdBackend
    node "MHM-HYPERV1" as ProdHyperV1
    node "MHM-HYPERV3" as ProdHyperV3
    node "MHM-HYPERV4" as ProdHyperV4
    database "Domain Controller\narchiv.mhm.siemens.com\n(AGLP-Gruppenstruktur)" as ProdAD
  }

  actor "Mitarbeitende" as User

  User -[#444444]-> ReverseProxy : HTTPS
  ReverseProxy -[#444444]-> ProdBackend : HTTP (intern)
  ProdBackend -[#B8860B]-> ProdHyperV1 : WinRM/Kerberos\n(Port 5985)
  ProdBackend -[#B8860B]-> ProdHyperV3 : WinRM/Kerberos\n(Port 5985)
  ProdBackend -[#B8860B]-> ProdHyperV4 : WinRM/Kerberos\n(Port 5985)
  ProdBackend -[#444444]-> ProdAD : LDAPS (Port 636)
}

note bottom of ProdHyperV4
  Getrennter Anwendungs- und Hyper-V-Host: HyperVProvider
  steuert im Remote-Modus mehrere Hosts gleichzeitig ueber
  WinRM/Kerberos an (ein wiederverwendbarer RunspacePool je
  Host), implementiert und gegen alle drei Hosts erfolgreich
  getestet. Der Local-Modus aus der Entwicklungsumgebung
  (oben) bleibt als Alternative fuer Deployments mit
  gemeinsamem Anwendungs-/Hyper-V-Host bestehen.
end note

DevVM -[hidden]-> SiemensNet

@enduml

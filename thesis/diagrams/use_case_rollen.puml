@startuml use_case_rollen
title Use-Cases je VM-Rolle (Rollenhierarchie mit Vererbung)
left to right direction

skinparam backgroundColor white
skinparam shadowing false
skinparam roundCorner 0
skinparam defaultFontSize 12
skinparam actorStyle awesome
skinparam usecase {
  BackgroundColor #F5F5F5
  BorderColor #4D4D4D
  ArrowColor #4D4D4D
}
skinparam actor {
  BackgroundColor #F5F5F5
  BorderColor #4D4D4D
}

actor Viewer
actor Operator
actor PowerUser
actor Admin
actor FullAdmin

' Rollenvererbung gemaess VmRole (Viewer=0 < Operator=1 < PowerUser=2 < Admin=3 < FullAdmin=4):
' eine hoehere Rolle erbt alle Rechte der niedrigeren Rolle.
Operator --|> Viewer
PowerUser --|> Operator
Admin --|> PowerUser
FullAdmin --|> Admin

rectangle "VmPortal — autorisierbare Aktionen (Auszug, vollständig: Tabelle RolePermissions)" {
  usecase "VM-Status ansehen" as UC_View
  usecase "Betrieb steuern\n(Start / Stopp / Pause)" as UC_Betrieb
  usecase "VM zurücksetzen" as UC_Reset
  usecase "Snapshots erstellen\n& anwenden" as UC_Snap
  usecase "Snapshot löschen" as UC_SnapDelete
  usecase "Ressourcen & Netzwerk\nanpassen" as UC_Resize
  usecase "Export / Import /\nKlonen" as UC_ExportImport
}

' Jeder Use Case ist an die jeweils niedrigste berechtigte Rolle geknüpft;
' hoehere Rollen erhalten das Recht ausschliesslich ueber die Aktorvererbung oben.
Viewer -- UC_View
Operator -- UC_Betrieb
PowerUser -- UC_Reset
PowerUser -- UC_Snap
Admin -- UC_SnapDelete
Admin -- UC_Resize
FullAdmin -- UC_ExportImport

@enduml

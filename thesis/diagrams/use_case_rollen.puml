@startuml use_case_rollen
!pragma layout smetana
title Use-Cases je VM-Rolle (Rollenhierarchie mit Vererbung)
left to right direction

skinparam backgroundColor white
skinparam actorStyle awesome
skinparam usecase {
  BackgroundColor #F2F2F2
  BorderColor #444444
}

actor Viewer
actor Operator
actor PowerUser
actor Admin
actor FullAdmin

' Rollenvererbung gemaess VmRole (Viewer=0 < Operator=1 < PowerUser=2 < Admin=3 < FullAdmin=4):
' eine hoehere Rolle erbt alle Rechte der niedrigeren Rolle.
Operator --|> Viewer
PowerUser --|> Operator
Admin --|> PowerUser
FullAdmin --|> Admin

rectangle "VmPortal — autorisierbare Aktionen (Auszug aus RolePermissions)" {
  usecase "VM-Status ansehen\n(ViewStatus)" as UC_View
  usecase "VM starten\n(Start)" as UC_Start
  usecase "VM stoppen\n(Stop)" as UC_Stop
  usecase "VM pausieren / fortsetzen\n(Pause / Resume)" as UC_Pause
  usecase "VM zurücksetzen\n(Reset)" as UC_Reset
  usecase "Snapshot erstellen\n(SnapshotCreate)" as UC_SnapCreate
  usecase "Snapshot wiederherstellen\n(SnapshotApply)" as UC_SnapApply
  usecase "Snapshot löschen\n(SnapshotDelete)" as UC_SnapDelete
  usecase "Ressourcen anpassen: RAM/CPU\n(ResizeRam / ResizeCpu)" as UC_Resize
  usecase "Netzwerk konfigurieren\n(AttachNetworkAdapter)" as UC_Network
  usecase "VM exportieren / importieren / klonen\n(Export / Import / Clone)" as UC_ExportImport
}

' Jeder Use Case ist an die jeweils niedrigste berechtigte Rolle geknüpft;
' hoehere Rollen erhalten das Recht ausschliesslich ueber die Aktorvererbung oben.
Viewer -- UC_View

Operator -- UC_Start
Operator -- UC_Stop
Operator -- UC_Pause

PowerUser -- UC_Reset
PowerUser -- UC_SnapCreate
PowerUser -- UC_SnapApply

Admin -- UC_SnapDelete
Admin -- UC_Resize
Admin -- UC_Network

FullAdmin -- UC_ExportImport

note bottom of UC_ExportImport
  Auszug: RolePermissions.cs definiert
  insgesamt 22 Aktionen (VmAction-Enum);
  hier sind die in Kapitel 5 diskutierten
  Kernaktionen je Rollenstufe dargestellt.
end note

@enduml

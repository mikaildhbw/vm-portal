@startuml sequenz_vm_aktion_autorisierung
title Sequenzdiagramm: VM-Aktion mit Autorisierungsprüfung (Beispiel "Start")

skinparam backgroundColor white
skinparam shadowing false
skinparam roundCorner 0
skinparam defaultFontSize 12
skinparam sequenceMessageAlign center
skinparam maxMessageSize 170
skinparam sequence {
  ParticipantBackgroundColor #F5F5F5
  ParticipantBorderColor #4D4D4D
  ActorBackgroundColor #F5F5F5
  ActorBorderColor #4D4D4D
  LifeLineBorderColor #999999
  ArrowColor #4D4D4D
  GroupBackgroundColor #F5F5F5
  GroupBorderColor #999999
}
skinparam note {
  BackgroundColor #FAFAFA
  BorderColor #999999
}

actor Benutzer
participant "Frontend\n(React-SPA)" as Frontend
participant "VmController" as VmController
participant "DbAuthorizationService\n(IDbAuthorizationService)" as DbAuth
participant "HyperVProvider\n(IVirtualizationProvider)" as HyperVProvider
participant "Hyper-V-Host(s)" as HyperV

Benutzer -> Frontend : Klickt "Start" für VM
Frontend -> VmController : POST /api/vm/{id}/start
activate VmController

VmController -> HyperVProvider : GetVmByIdAsync(id)
HyperVProvider -> HyperV : Get-VM (lokal oder WinRM)
HyperV --> HyperVProvider : VM-Objekt oder leer

alt vm == null (unbekannte VM)
  VmController --> Frontend : 404 Not Found
  Frontend --> Benutzer : Fehlermeldung anzeigen

else VM gefunden

  VmController -> DbAuth : IsAllowedAsync(adGroups, vm.Name, VmAction.Start)
  DbAuth -> DbAuth : VM-Gruppe auflösen, passende\nGroupPermissions ermitteln, Union bilden
  DbAuth --> VmController : bool erlaubt

  alt keine GroupPermission ODER Aktion nicht erlaubt
    note right of VmController
      403 mit unterscheidbarer Log-Ursache:
      VM ohne Gruppe / keine passende
      GroupPermission / Aktion nicht erlaubt.
    end note
    VmController --> Frontend : 403 Forbidden
    Frontend --> Benutzer : Fehlermeldung "Keine Berechtigung"

  else Aktion erlaubt
    VmController -> HyperVProvider : StartVmAsync(id)
    HyperVProvider -> HyperV : Start-VM (lokal oder WinRM)

    alt PowerShell-Fehler (Hyper-V nicht erreichbar o. ä.)
      HyperV --> HyperVProvider : Fehler
      HyperVProvider --> VmController : throw VirtualizationException
      note right of VmController
        Übersetzung in 502 Bad Gateway
        durch VirtualizationExceptionMiddleware.
      end note
      VmController --> Frontend : 502 Bad Gateway

    else Ausführung erfolgreich
      HyperV --> HyperVProvider : Erfolg
      HyperVProvider --> VmController : Task abgeschlossen
      VmController --> Frontend : 200 OK
      Frontend --> Benutzer : VM-Status aktualisiert
    end
  end
end
deactivate VmController

@enduml

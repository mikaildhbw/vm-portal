@startuml er_diagramm_autorisierung
title Implementierte Autorisierungsschicht (SQLite/EF Core)

skinparam backgroundColor white
skinparam entity {
  BackgroundColor #E8F4EA
  BorderColor #2E7D32
}
skinparam note {
  BackgroundColor #E8F4EA
  BorderColor #2E7D32
}

note as N1
  Persistente RBAC-Schicht neben dem Active Directory (Hybrid-Architektur:
  AD authentifiziert, SQLite autorisiert). Umgesetzt in
  VmPortal.Core/Data (VmPortalDbContext, Entities, Migrations) und
  verwaltet ueber die Admin-Endpunkte /api/admin/* sowie die
  Administrationsoberflaeche im Frontend (Kapitel 6.7). Ersetzt die
  zuvor im JWT-Claim "vmroles" gefuehrte, nicht persistente Zuordnung
  als einzige tatsaechlich wirksame Autorisierungsquelle (siehe
  Kapitel 5.3 und 6.3, docs/authorization.md).
end note

entity "VirtualServers" as VirtualServers {
  * Id : PK
  --
  Address : string
  Platform : string
  Name : string
}

entity "VirtualMachines" as VirtualMachines {
  * Id : PK
  --
  ServerId : FK -> VirtualServers.Id
  GroupId : FK -> VirtualMachineGroups.Id (nullable)
  Name : string
  VmGuid : string (nullable)
  ..
  GroupId = null => secure-by-default
  (VM unsichtbar, keine Rechte)
  ..
  VmGuid: Hyper-V-VM-GUID, nur zur
  Nachvollziehbarkeit im Multi-Host-
  Betrieb, nicht Teil der Rechtepruefung
  (die bleibt Server+Name-basiert)
}

entity "VirtualMachineGroups" as VirtualMachineGroups {
  * Id : PK
  --
  Name : string
}

entity "UserGroups" as UserGroups {
  * Id : PK
  --
  Name : string
  ..
  1:1-Abbild einer AD-Gruppe
  (nur Name, kein Sync)
}

entity "Roles" as Roles {
  * Id : PK
  --
  Name : string
  IsSystemRole : bool
  Level : int
  ..
  Level dient nur der UI-Sortierung,
  nicht der Rechteableitung
}

entity "VMActions" as VMActions {
  * Id : PK
  --
  Name : string
  ..
  Abbild von VmAction (22 Werte)
}

entity "RoleActions" as RoleActions {
  * Id : PK
  --
  RoleId : FK -> Roles.Id
  ActionId : FK -> VMActions.Id
  ..
  UNIQUE(RoleId, ActionId)
  explizite, vollstaendige Rechte-
  menge je Rolle, keine Vererbung
}

entity "GroupPermissions" as GroupPermissions {
  * Id : PK
  --
  VmGroupId : FK -> VirtualMachineGroups.Id
  UserGroupId : FK -> UserGroups.Id
  RoleId : FK -> Roles.Id
  ..
  UNIQUE(VmGroupId, UserGroupId, RoleId)
  mehrere Rollen pro Paar moeglich
  -> Union statt "hoechste Rolle gewinnt"
}

VirtualServers ||--o{ VirtualMachines : "hostet"
VirtualMachineGroups |o--o{ VirtualMachines : "enthaelt (optional)"

Roles ||--o{ RoleActions : "erlaubt"
VMActions ||--o{ RoleActions : "ist erlaubt in"

VirtualMachineGroups ||--o{ GroupPermissions : "wird berechtigt fuer"
UserGroups ||--o{ GroupPermissions : "erhaelt Berechtigung auf"
Roles ||--o{ GroupPermissions : "als zugewiesene Rolle"

@enduml
